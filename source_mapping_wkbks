# Setup logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

def retry_request(func, *args, **kwargs):
    """Retry a request with exponential backoff"""
    for attempt in range(MAX_RETRIES):
        try:
            return func(*args, **kwargs)
        except Exception as e:
            if attempt == MAX_RETRIES - 1:
                raise
            wait_time = RETRY_DELAY * (2 ** attempt)
            logger.warning(f"Attempt {attempt + 1} failed: {e}. Retrying in {wait_time}s...")
            time.sleep(wait_time)

def get_all_datasources_detailed(server):
    """Get all datasources with detailed connection information"""
    print("💾 Fetching all datasources with detailed information...")
    datasources_dict = {}
    
    try:
        req = TSC.RequestOptions()
        req.page_size = PAGE_SIZE
        page = 1
        
        while True:
            req.page_number = page
            datasources_page, pagination = retry_request(server.datasources.get, req_options=req)
            
            for ds in datasources_page:
                # Store basic datasource info first
                datasources_dict[ds.id] = {
                    'name': getattr(ds, 'name', 'Unknown'),
                    'datasource_type': getattr(ds, 'datasource_type', ''),
                    'created_at': getattr(ds, 'created_at', None),
                    'updated_at': getattr(ds, 'updated_at', None),
                    'project_id': getattr(ds, 'project_id', ''),
                    'owner_id': getattr(ds, 'owner_id', ''),
                    'connections': []
                }
                
                # Try to get detailed connection info
                try:
                    server.datasources.populate_connections(ds)
                    
                    # Get connection details
                    connections_info = []
                    if hasattr(ds, 'connections') and ds.connections:
                        for conn in ds.connections:
                            conn_info = {
                                'server_address': getattr(conn, 'server_address', ''),
                                'server_port': getattr(conn, 'server_port', ''),
                                'connection_type': getattr(conn, 'connection_type', ''),
                                'username': getattr(conn, 'username', ''),
                                'database_name': getattr(conn, 'database_name', ''),
                                'query_tagging_enabled': getattr(conn, 'query_tagging_enabled', False)
                            }
                            connections_info.append(conn_info)
                    
                    datasources_dict[ds.id]['connections'] = connections_info
                    
                    print(f"   📊 Found datasource: {ds.name} (ID: {ds.id[:8]}...) - {len(connections_info)} connections")
                    
                except Exception as e:
                    logger.warning(f"Could not get connection details for datasource {ds.name}: {e}")
                    # Keep the basic info we already stored
            
            if not (pagination.page_number * pagination.page_size < pagination.total_available):
                break
            page += 1
            
        print(f"✅ Found {len(datasources_dict)} total datasources")
        
    except Exception as e:
        logger.error(f"Error fetching datasources: {e}")
    
    return datasources_dict

def extract_workbook_datasource_details(server, wb, project, datasources_dict):
    """Extract detailed datasource information for a workbook"""
    rows = []
    
    try:
        # Try to populate workbook connections
        try:
            server.workbooks.populate_connections(wb)
        except Exception as e:
            logger.warning(f"Could not populate connections for workbook {wb.name}: {e}")
            wb.connections = []

        wb_url = f"{SERVER}/#/site/{SITE_ID}/workbooks/{wb.content_url}"
        
        # Get workbook connections
        wb_connections = getattr(wb, "connections", [])
        
        if not wb_connections:
            # Workbook with no data sources
            rows.append({
                "project_name": project.name,
                "project_id": wb.project_id,
                "workbook_name": wb.name,
                "workbook_id": wb.id,
                "workbook_url": wb_url,
                "workbook_created": getattr(wb, "created_at", None),
                "workbook_updated": getattr(wb, "updated_at", None),
                "workbook_owner_id": getattr(wb, "owner_id", None),
                "datasource_name": None,
                "datasource_id": None,
                "datasource_type": None,
                "datasource_created": None,
                "datasource_updated": None,
                "connection_server_address": None,
                "connection_server_port": None,
                "connection_type": None,
                "connection_username": None,
                "connection_database_name": None,
                "connection_query_tagging": None,
                "data_comes_from": None
            })
        else:
            # Process each connection/datasource
            for conn in wb_connections:
                datasource_id = getattr(conn, 'datasource_id', None)
                
                # Get datasource details from our dictionary
                ds_info = datasources_dict.get(datasource_id, {})
                
                # Try multiple ways to get the datasource name
                datasource_name = None
                if ds_info:
                    datasource_name = ds_info.get('name', 'Unknown')
                
                # If still no name, try to get it from the connection itself
                if not datasource_name or datasource_name == 'Unknown':
                    # Try to get name from connection attributes
                    datasource_name = getattr(conn, 'datasource_name', None)
                    if not datasource_name:
                        # Try to construct name from server/database
                        server_addr = getattr(conn, 'server_address', '')
                        db_name = getattr(conn, 'database_name', '')
                        if server_addr or db_name:
                            datasource_name = f"{server_addr}_{db_name}" if server_addr and db_name else (server_addr or db_name)
                        else:
                            datasource_name = "Embedded/Unknown"
                
                ds_connections = ds_info.get('connections', [])
                
                # If we have detailed connections, create a row for each
                if ds_connections:
                    for ds_conn in ds_connections:
                        # Build "data comes from" field
                        data_comes_from_parts = []
                        if ds_conn.get('server_address'):
                            data_comes_from_parts.append(ds_conn['server_address'])
                        if ds_conn.get('database_name'):
                            data_comes_from_parts.append(ds_conn['database_name'])
                        data_comes_from = " / ".join(data_comes_from_parts) if data_comes_from_parts else None
                        
                        rows.append({
                            "project_name": project.name,
                            "project_id": wb.project_id,
                            "workbook_name": wb.name,
                            "workbook_id": wb.id,
                            "workbook_url": wb_url,
                            "workbook_created": getattr(wb, "created_at", None),
                            "workbook_updated": getattr(wb, "updated_at", None),
                            "workbook_owner_id": getattr(wb, "owner_id", None),
                            "datasource_name": datasource_name,
                            "datasource_id": datasource_id,
                            "datasource_type": ds_info.get('datasource_type', None),
                            "datasource_created": ds_info.get('created_at', None),
                            "datasource_updated": ds_info.get('updated_at', None),
                            "connection_server_address": ds_conn.get('server_address', ''),
                            "connection_server_port": ds_conn.get('server_port', ''),
                            "connection_type": ds_conn.get('connection_type', ''),
                            "connection_username": ds_conn.get('username', ''),
                            "connection_database_name": ds_conn.get('database_name', ''),
                            "connection_query_tagging": ds_conn.get('query_tagging_enabled', False),
                            "data_comes_from": data_comes_from
                        })
                else:
                    # Single row with basic connection info from workbook connection
                    conn_server = getattr(conn, 'server_address', '')
                    conn_db = getattr(conn, 'database_name', '')
                    data_comes_from = f"{conn_server} / {conn_db}" if conn_server and conn_db else (conn_server or conn_db or None)
                    
                    rows.append({
                        "project_name": project.name,
                        "project_id": wb.project_id,
                        "workbook_name": wb.name,
                        "workbook_id": wb.id,
                        "workbook_url": wb_url,
                        "workbook_created": getattr(wb, "created_at", None),
                        "workbook_updated": getattr(wb, "updated_at", None),
                        "workbook_owner_id": getattr(wb, "owner_id", None),
                        "datasource_name": datasource_name,
                        "datasource_id": datasource_id,
                        "datasource_type": ds_info.get('datasource_type', None),
                        "datasource_created": ds_info.get('created_at', None),
                        "datasource_updated": ds_info.get('updated_at', None),
                        "connection_server_address": conn_server,
                        "connection_server_port": getattr(conn, 'server_port', ''),
                        "connection_type": getattr(conn, 'connection_type', ''),
                        "connection_username": getattr(conn, 'username', ''),
                        "connection_database_name": conn_db,
                        "connection_query_tagging": None,
                        "data_comes_from": data_comes_from
                    })

    except Exception as e:
        logger.error(f"Error processing workbook {wb.name}: {e}")
        # Add error row to show the workbook exists but had issues
        rows.append({
            "project_name": project.name,
            "project_id": wb.project_id,
            "workbook_name": wb.name,
            "workbook_id": wb.id,
            "workbook_url": f"ERROR: {e}",
            "workbook_created": None,
            "workbook_updated": None,
            "workbook_owner_id": None,
            "datasource_name": "ERROR",
            "datasource_id": None,
            "datasource_type": None,
            "datasource_created": None,
            "datasource_updated": None,
            "connection_server_address": None,
            "connection_server_port": None,
            "connection_type": None,
            "connection_username": None,
            "connection_database_name": None,
            "connection_query_tagging": None,
            "data_comes_from": None
        })

    return rows

def main():
    print("="*80)
    print("🚀 TABLEAU WORKBOOK DATA SOURCE EXTRACTION")
    print("="*80)
    start_time = datetime.now()
    print(f"⏰ Started at: {start_time.strftime('%Y-%m-%d %H:%M:%S')}")
    
    server = TSC.Server(SERVER, use_server_version=True)
    auth = TSC.PersonalAccessTokenAuth(PAT_NAME, PAT_SECRET, SITE_ID)

    all_rows = []

    try:
        with server.auth.sign_in(auth):
            print(f"✅ Successfully connected to {SERVER}")
            print()

            # Step 1: Get all datasources with detailed connection info
            datasources_dict = get_all_datasources_detailed(server)
            print()

            # Step 2: Get all projects
            print("📁 Fetching all projects...")
            projects_by_id = {}
            req = TSC.RequestOptions()
            req.page_size = PAGE_SIZE
            
            page = 1
            while True:
                req.page_number = page
                projects, pagination = retry_request(server.projects.get, req_options=req)
                
                for p in projects:
                    projects_by_id[p.id] = p
                
                if not (pagination.page_number * pagination.page_size < pagination.total_available):
                    break
                page += 1
            
            print(f"✅ Found {len(projects_by_id)} projects")
            print()

            # Step 3: Get all workbooks and process them
            print("📚 Fetching and processing all workbooks...")
            req = TSC.RequestOptions()
            req.page_size = PAGE_SIZE
            
            total_workbooks = 0
            processed_workbooks = 0
            
            page = 1
            while True:
                print(f"\n📖 Processing workbooks page {page}...")
                req.page_number = page
                
                workbooks_page, pagination = retry_request(server.workbooks.get, req_options=req)
                
                for wb in workbooks_page:
                    total_workbooks += 1
                    
                    # Get project info
                    project = projects_by_id.get(wb.project_id)
                    if not project:
                        logger.warning(f"Could not find project for workbook {wb.name}")
                        continue
                    
                    print(f"   📊 [{processed_workbooks + 1:3d}] Processing: {wb.name[:60]}...")
                    
                    # Extract datasource details
                    wb_rows = extract_workbook_datasource_details(server, wb, project, datasources_dict)
                    all_rows.extend(wb_rows)
                    processed_workbooks += 1
                    
                    # Progress update every 25 workbooks
                    if processed_workbooks % 25 == 0:
                        print(f"   ✅ Processed {processed_workbooks} workbooks so far...")
                
                if not (pagination.page_number * pagination.page_size < pagination.total_available):
                    break
                page += 1

            print(f"\n📊 Total workbooks found: {total_workbooks}")
            print(f"📊 Total workbooks processed: {processed_workbooks}")

    except KeyboardInterrupt:
        print(f"\n\n⚠️ Extraction interrupted by user!")
        print(f"📊 Processed {processed_workbooks} workbooks")
        
    except Exception as e:
        logger.error(f"Unexpected error: {e}")
        print(f"💾 Saving partial results...")

    # Save results
    print(f"\n\n" + "="*80)
    print("💾 SAVING RESULTS")
    print("="*80)
    
    if all_rows:
        df = pd.DataFrame(all_rows)
        df_sorted = df.sort_values(
            ["project_name", "workbook_name", "datasource_name"], 
            na_position="last"
        )
        
        output_path = os.path.abspath(OUTPUT_CSV)
        df_sorted.to_csv(output_path, index=False)

        # Summary statistics
        unique_projects = df['project_name'].nunique()
        unique_workbooks = df[df['workbook_name'].notna()]['workbook_id'].nunique()
        unique_datasources = df[df['datasource_name'].notna() & (df['datasource_name'] != 'ERROR')]['datasource_name'].nunique()
        total_connections = len(df[df['connection_type'].notna()])
        
        end_time = datetime.now()
        duration = end_time - start_time

        print("="*80)
        print("🎉 EXTRACTION COMPLETED!")
        print("="*80)
        print(f"📊 SUMMARY:")
        print(f"   🗂️  Projects: {unique_projects}")
        print(f"   📚 Workbooks: {unique_workbooks}")
        print(f"   💾 Data Sources: {unique_datasources}")
        print(f"   🔌 Connections: {total_connections}")
        print(f"   📝 Total Rows: {len(df)}")
        print(f"   ⏱️  Duration: {duration}")
        print(f"   📁 Output File: {output_path}")
        
        # Show top data source types
        print(f"\n📋 TOP CONNECTION TYPES:")
        conn_types = df[df['connection_type'].notna()]['connection_type'].value_counts().head(10)
        for conn_type, count in conn_types.items():
            print(f"   • {conn_type}: {count}")

        # Show sample of data
        print(f"\n📋 SAMPLE DATA:")
        sample_df = df[['workbook_name', 'datasource_name', 'connection_type', 'data_comes_from']].head(5)
        print(sample_df.to_string(index=False, max_colwidth=40))

        # Try to open Excel
        try:
            if sys.platform.startswith("win"):
                subprocess.Popen(["excel.exe", output_path], shell=True)
            elif sys.platform == "darwin":
                subprocess.Popen(["open", "-a", "Microsoft Excel", output_path])
            else:
                subprocess.Popen(["xdg-open", output_path])
            print("📊 Opening Excel...")
        except:
            print("⚠️ Could not auto-open Excel")
            
    else:
        print("❌ No data was extracted!")

    print(f"\n🏁 Script completed at: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")

if __name__ == "__main__":
    main()
